<!doctype html>
<html lang="th">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>บันทึกการรับเงิน</title>
    <link rel="stylesheet" href="/public/style.css">
</head>

<body>
    <div class="staff-shell">
        <header class="staff-top">
            <h1>พนักงานแคชเชียร์</h1>
        </header>
        <main class="cashier-content">
            <section class="panel success-panel">
                <div class="checkmark">✓</div>
                <h2>ชำระเงินสำเร็จ - ปิดบิลแล้ว</h2>
                <p>รวม <%= total %> ฿ · เงินทอน <%= change %> ฿</p>
                <hr>
                <div class="success-status"><span>สถานะโต๊ะ <%= String(table).padStart(2,"0") %></span><b>ว่าง</b></div>
                <div class="actions"><a class="outline-btn full-btn" href="/cashier">กลับหน้าสถานะโต๊ะ</a><button
                        class="secondary-btn full-btn" onclick="return false">พิมพ์ใบเสร็จ</button></div>
            </section>
        </main>
    </div>
</body>

</html>