<!doctype html>
<html lang="th">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="refresh" content="8">
    <title>พนักงานบริการ</title>
    <link rel="stylesheet" href="/public/style.css">
</head>

<body>
    <div class="staff-shell">
        <header class="staff-top">
            <h1>พนักงานบริการ</h1>
            <nav><a href="/kitchen">พนักงานครัว</a><a class="active" href="/service">หน้าจอเมนู</a><a
                    href="/cashier">แคชเชียร์</a></nav>
        </header>
        <main class="staff-content">
            <h2>หน้าจอเมนู</h2>
            <% if(!orders.length){ %>
                <div class="staff-empty">ยังไม่มีอาหารที่พร้อมเสิร์ฟ</div>
                <% } %>
                    <div class="order-board">
                        <% orders.forEach(order=>{ %><article class="work-card">
                                <div class="work-title">โต๊ะ <%= String(order.table_no).padStart(2,"0") %><span>#<%=
                                                order.order_id %></span></div>
                                <ul>
                                    <% order.items.forEach(item=>{let
                                        ads=[];try{ads=JSON.parse(item.addons||"[]")}catch(e){} %><li>
                                            <%= item.name %> × <%= item.quantity %>
                                                    <% if(ads.length){ %><small>
                                                            <%= ads.map(a=>a.name).join(" · ") %>
                                                        </small>
                                                        <% } %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <form action="/service/served" method="post"><input type="hidden" name="order_id"
                                        value="<%= order.order_id %>"><button class="green-btn full">เสิร์ฟแล้ว</button>
                                </form>
                            </article>
                            <% }) %>
                    </div>
                    <section class="tablet-section">
                        <h2>แท็บเล็ตควบคุม</h2>
                        <div class="tablet">
                            <div class="speaker"></div>
                            <div class="tablet-screen">
                                <% if(!orders.length){ %>
                                    <div class="tablet-empty">ไม่มีรายการ</div>
                                    <% } %>
                                        <% orders.forEach(order=>{ %><div class="tablet-row"><span>โต๊ะ <%=
                                                        String(order.table_no).padStart(2,"0") %></span>
                                                <form action="/service/served" method="post"><input type="hidden"
                                                        name="order_id" value="<%= order.order_id %>"><button
                                                        class="green-btn">เสิร์ฟแล้ว</button></form>
                                            </div>
                                            <% }) %>
                            </div>
                            <div class="home-button"></div>
                        </div>
                    </section>
        </main>
    </div>
</body>

</html>