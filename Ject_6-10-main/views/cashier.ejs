<!doctype html>
<html lang="th">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>พนักงานแคชเชียร์</title>
    <link rel="stylesheet" href="/public/style.css">
</head>

<body>
    <div class="staff-shell">
        <header class="staff-top">
            <h1>พนักงานแคชเชียร์</h1>
            <nav><a href="/kitchen">ครัว</a><a href="/service">บริการ</a><a class="active" href="/cashier">แคชเชียร์</a>
            </nav>
        </header>
        <main class="cashier-content">
            <section class="panel">
                <div class="panel-head">
                    <h2>สถานะโต๊ะ</h2>
                    <div class="status-actions">
                        <form action="/cashier/toggle-mode" method="post"><input type="hidden" name="selected"
                                value="<%= selected||'' %>"><button type="submit"
                                class="<%= mode?'orange-btn':'blue-btn' %>">
                                <%= mode?'กำลังเปลี่ยนสถานะโต๊ะ':'เปลี่ยนสถานะโต๊ะ' %>
                            </button></form>
                        <% if(mode && selected){ %>
                            <form action="/cashier/confirm-status" method="post"><input type="hidden" name="table"
                                    value="<%= selected %>"><button type="submit"
                                    class="green-btn">ยืนยันการเปลี่ยนสถานะโต๊ะ</button></form>
                            <% } %>
                    </div>
                </div>
                <div class="tables-grid">
                    <% tables.forEach(t=>{ %><% if(mode){ %>
                            <form class="table-form" action="/cashier/table-status" method="post"><input type="hidden"
                                    name="table" value="<%= t.table_no %>"><button
                                    class="table-tile <%= t.status==='ว่าง'?'vacant':'occupied' %> <%= selected===t.table_no?'selected':'' %>"
                                    type="submit"><b>
                                        <%= String(t.table_no).padStart(2,'0') %>
                                    </b><span>
                                        <%= t.status %>
                                    </span></button></form>
                            <% } else { %><a
                                    class="table-tile <%= t.status==='ว่าง'?'vacant':'occupied' %> <%= selected===t.table_no?'selected':'' %>"
                                    href="/cashier?selected=<%= t.table_no %>"><b>
                                        <%= String(t.table_no).padStart(2,'0') %>
                                    </b><span>
                                        <%= t.status %>
                                    </span></a>
                                <% } %>
                                    <% }) %>
                </div>
            </section>
            <% if(selected){ %>
                <section class="panel bill-panel">
                    <div class="panel-head">
                        <h2>ข้อมูลบิล - โต๊ะ <%= String(selected).padStart(2,"0") %>
                        </h2>
                    </div>
                    <% if(bill && bill.items.length){ %>
                        <div class="bill-lines">
                            <% bill.items.forEach(item=>{let ads=[];try{ads=JSON.parse(item.addons||"[]")}catch(e){} %>
                                <div class="bill-line"><span>- <%= item.name %> × <%= item.quantity %>
                                                <% if(ads.length){ %><small>
                                                        <%= ads.map(a=>a.name).join(" · ") %>
                                                    </small>
                                                    <% } %></span><b>
                                        <%= item.total_price %> ฿
                                    </b></div>
                                <% }) %>
                        </div>
                        <div class="bill-total"><span>ยอดรวม</span><b>
                                <%= bill.total %> ฿
                            </b></div><a class="blue-btn full-btn" href="/payment/<%= selected %>">รับชำระเงิน</a>
                        <% } else { %>
                            <div class="empty bill-empty">ยังไม่มีรายการอาหารของโต๊ะนี้</div>
                            <% } %>
                </section>
                <% } %>
                    <% if(mode){ %>
                        <div class="hint">โหมดเปลี่ยนสถานะโต๊ะ: กดโต๊ะเพื่อสลับ ว่าง / ไม่ว่าง · หากไม่เปิดโหมดนี้
                            การกดโต๊ะจะเป็นการดูข้อมูลบิล</div>
                        <% } %>
        </main>
    </div>
</body>

</html>